# Copy/configure locally. Never commit real values.
LTA_MODE=OFFLINE_FIXTURE
LTA_CAPTURE_DIR=private/captures
LTA_DATAMALL_KEY=
LTA_KEY_PATH=
API_SERVICE_TOKEN=
DATABASE_URL=
REDIS_URL=
CACHE_TTL_SECONDS=30
MIN_POLL_INTERVAL_SECONDS=20
UPSTREAM_TIMEOUT_SECONDS=10
MAX_ACTIVE_STOPS=128
MAX_CACHE_ENTRIES=512
ACTIVE_STOPS=
# Docker database/cache passwords are independently generated by tools/init_local.py.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Privileged migration tool only; never reuse as a commuter connection.
MIGRATION_DATABASE_URL=
# Separate server-only logins/provider configuration for component integration.
# HTTP integration is pending; the ingestion API does not yet consume these.
APP_DATABASE_URL=
COMMUTER_API_ENABLED=false
WORKER_DATABASE_URL=
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
